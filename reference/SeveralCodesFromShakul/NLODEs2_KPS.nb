d24f2411e608"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"VvalsSS", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"V0", "->", "2"}], ",", 
     RowBox[{"V1", "->", "2"}], " ", ",", " ", 
     RowBox[{"V4", "->", "3"}], ",", " ", 
     RowBox[{"kf", "->", "1"}], ",", 
     RowBox[{"k", "->", "10"}], ",", 
     RowBox[{"\[Beta]", "->", " ", "0.52"}], ",", 
     RowBox[{"\[Epsilon]", "->", "11"}], " ", ",", 
     RowBox[{"VM2", "->", "6"}], ",", 
     RowBox[{"k2", "->", "0.1"}], ",", 
     RowBox[{"VM3", "->", "30"}], ",", 
     RowBox[{"m", "->", "2"}], ",", 
     RowBox[{"kx", "->", "0.6"}], ",", 
     RowBox[{"ky", "->", "0.3"}], ",", 
     RowBox[{"kz", "->", "0.1"}], ",", 
     RowBox[{"VM5", "->", "50"}], ",", 
     RowBox[{"k5", "->", "0.3194"}], ",", 
     RowBox[{"kd", "->", "1"}], ",", 
     RowBox[{"p", "->", "1"}], ",", 
     RowBox[{"n", "->", "4"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"solSS1", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"NLODEs", "/.", "VvalsSS"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"x", "[", "0", "]"}], "==", 
            RowBox[{"RandomReal", "[", 
             RowBox[{"{", 
              RowBox[{"0", ",", "1000"}], "}"}], "]"}]}], ",", 
           RowBox[{
            RowBox[{"y", "[", "0", "]"}], "==", 
            RowBox[{"RandomReal", "[", 
             RowBox[{"{", 
              RowBox[{"0", ",", "100"}], "}"}], "]"}]}], ",", 
           RowBox[{
            RowBox[{"z", "[", "0", "]"}], "==", 
            RowBox[{"RandomReal", "[", 
             RowBox[{"{", 
              RowBox[{"0", ",", "100"}], "}"}], "]"}]}]}], "}"}]}], "]"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "[", "t", "]"}], ",", 
         RowBox[{"y", "[", "t", "]"}], ",", 
         RowBox[{"z", "[", "t", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "tmax"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "10"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xv1", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], "/.", 
      RowBox[{"solSS1", "[", 
       RowBox[{"[", "nn", "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"nn", ",", "1", ",", "10"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{"xv1", ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9312121429813623`*^9, 3.931212180213072*^9}, {
