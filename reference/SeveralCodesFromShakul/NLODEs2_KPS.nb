 RowBox[{
  RowBox[{"solSS1", "=", " ", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"NLODEs", "/.", "VvalsSS"}], ",", 
       RowBox[{"{", 
