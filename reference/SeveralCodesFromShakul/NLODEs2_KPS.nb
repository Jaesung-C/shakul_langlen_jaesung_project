Cell["Birhythmicity", "Subsection",
 CellChangeTimes->{{3.9312137111868734`*^9, 3.93121371800345*^9}, {
  3.938810142397108*^9, 3.9388101434449425`*^9}, {3.9388125601459513`*^9, 
