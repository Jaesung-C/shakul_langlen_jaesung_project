Cell[BoxData[{
 RowBox[{
  RowBox[{"VvalsSS", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"V0", "->", "2"}], ",", 
     RowBox[{"V1", "->", "2"}], " ", ",", " ", 
     RowBox[{"V4", "->", "5"}], ",", " ", 
     RowBox[{"kf", "->", "1"}], ",", 
     RowBox[{"k", "->", "10"}], ",", 
     RowBox[{"\[Beta]", "->", " ", "0.51"}], ",", 
     RowBox[{"\[Epsilon]", "->", "0.1"}], " ", ",", 
     RowBox[{"VM2", "->", "6"}], ",", 
     RowBox[{"k2", "->", "0.1"}], ",", 
     RowBox[{"VM3", "->", "20"}], ",", 
     RowBox[{"m", "->", "2"}], ",", 
     RowBox[{"kx", "->", "0.5"}], ",", 
     RowBox[{"ky", "->", "0.2"}], ",", 
     RowBox[{"kz", "->", "0.2"}], ",", 
     RowBox[{"VM5", "->", "30"}], ",", 
     RowBox[{"k5", "->", "0.3"}], ",", 
     RowBox[{"kd", "->", "0.5"}], ",", 
     RowBox[{"p", "->", "2"}], ",", 
     RowBox[{"n", "->", "4"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"solSS1", "=", " ", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"NLODEs", "/.", "VvalsSS"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"x", "[", "0", "]"}], "==", "0"}], ",", 
         RowBox[{
          RowBox[{"y", "[", "0", "]"}], "==", "0"}], ",", 
         RowBox[{
          RowBox[{"z", "[", "0", "]"}], "==", "0"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "[", "t", "]"}], ",", 
       RowBox[{"y", "[", "t", "]"}], ",", 
       RowBox[{"z", "[", "t", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "tmax"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xv1", " ", "=", " ", 
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], "/.", "solSS1"}]}], ";"}], "\n", 
 RowBox[{"Plot", "[", 
